---
import { content, ui } from '../lib/content';
---
<a class="skip" href="#inicio">Ir al contenido</a>
<header class="header">
  <a class="brand" href="#inicio" aria-label="Ladera, inicio"><img src={`/${content.brand.logo}`} alt="Ladera" width="145" height="32" /></a>
  <nav class="desktop-nav" aria-label="Principal">{ui.nav.map(a => <a href={a.href}>{a.label}</a>)}</nav>
  <div class="header-actions"><a class="button small" href="#comprar">Comprar</a><button class="menu-toggle" aria-label="Abrir menú" aria-haspopup="dialog" aria-controls="menu-dialog" aria-expanded="false" hidden><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg></button></div>
</header>
<dialog id="menu-dialog" aria-labelledby="menu-title"><button class="close" data-close aria-label="Cerrar menú" autofocus><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button><h2 id="menu-title">Descubre Ladera</h2><nav class="menu-links" aria-label="Menú">{ui.nav.map(a => <a href={a.href}>{a.label}</a>)}<a href="#boca">En boca</a><a href="#comprar">Comprar</a></nav></dialog>
