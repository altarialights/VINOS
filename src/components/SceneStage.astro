---
import { content, ui } from '../lib/content';
import Asset from './Asset.astro';
import AmbientVideo from './AmbientVideo.astro';
import AmbientControl from './AmbientControl.astro';
import NarrativeChapter from './NarrativeChapter.astro';
import DepthForeground from './DepthForeground.astro';
import { motion } from '../config/motion-v2';
---
<div class="track" style={`--scene-count:${motion.scrollScreens + 1}`}><div class="stage">
  <div class="narrative-landscape" aria-hidden="true"><div></div></div>
  <div class="shared-scene" aria-hidden="true">
    <div class="scene-camera"><AmbientVideo scene="vineyard" priority /></div>
    <div class="scene-shade"></div><div class="reading-veil"></div>
    {[
      ['bottle', 'bottle-master', 74, 53, 91, 7],
      ['grapes', 'grapes-master', 25, 54, 84, 0],
      ['glass', 'glass-master', 25, 53, 77, 0],
      ['leaves', 'vine-foreground', 58, 40, 105, 0],
    ].map(([key, name, x, y, height, rotation]) => <div class="scene-depth" data-depth={key}><div class="subject-layer" data-layer={key} style={`--subject-x:${x}%;--subject-y:${y}%;--subject-height:${height}%;--subject-rotation:${rotation}deg`}><Asset name={String(name)} priority={key === 'bottle'} deferred={key !== 'bottle'} /></div></div>)}
  </div>
  <DepthForeground desktop />
  {content.chapters.slice(0, 3).map((chapter, index) => <NarrativeChapter chapter={chapter} index={index} />)}
  <div class="sensory-sequence">
    <div class="sensory-visual" aria-hidden="true"><Asset name="glass-master" alt="" /></div>
    {content.chapters.slice(3).map((chapter, index) => <NarrativeChapter chapter={chapter} index={index + 3} />)}
  </div>
  <div class="sequence-exit" aria-hidden="true"></div>
  <nav class="chapter-dots" aria-label="Capítulos">{content.chapters.map((c, i) => <a href={`#${c.id}`}>{ui.chapterLabels[i]}</a>)}</nav>
  <div class="ambient-controls"><AmbientControl /></div>
</div></div>
