---
import Asset from './Asset.astro';
import Arrow from './Arrow.astro';
---
<dialog id="demo-dialog" class="detail-dialog" aria-labelledby="demo-title" aria-describedby="demo-message">
  <button class="close" data-close aria-label="Cerrar ventana" autofocus><span aria-hidden="true">×</span></button>
  <div class="dialog-art" aria-hidden="true"><Asset name="bottle-master" /><span>LADERA · GARNACHA</span></div>
  <div class="dialog-copy"><p class="eyebrow" id="demo-eyebrow">UN VINO PARA COMPARTIR</p><h2 id="demo-title">Tu selección Ladera</h2><p id="demo-message"></p><div class="dialog-details" id="demo-details"></div><p class="dialog-disclaimer">Experiencia de demostración. Los detalles de la propuesta son ilustrativos; no se realizan pagos ni reservas.</p><button class="button" data-close>Seguir descubriendo<Arrow /></button></div>
</dialog>
