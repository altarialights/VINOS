---
import { content } from '../lib/content';
import AmbientVideo from './AmbientVideo.astro';
import AmbientControl from './AmbientControl.astro';
import Arrow from './Arrow.astro';
---
<section id="cata" class="tasting" aria-labelledby="tasting-title" tabindex="-1">
  <AmbientVideo scene="tasting" class="tasting-art" />
  <div class="tasting-inner"><p class="eyebrow">UNA INVITACIÓN A LA CATA</p><h2 id="tasting-title">{content.tasting.title}</h2><p class="body-copy">{content.tasting.body}</p>
    <form id="tasting-form" novalidate><div class="form-row"><div><label class="field-label" for="date">Fecha</label><input type="date" id="date" name="date" required aria-describedby="date-error" /><p id="date-error" class="form-error" hidden></p></div><div><label class="field-label" for="persons">Personas</label><input type="number" id="persons" name="persons" min="1" max="12" step="1" value="2" required inputmode="numeric" aria-describedby="persons-error" /><p id="persons-error" class="form-error" hidden></p></div></div>
    <button class="button form-submit" type="submit">{content.tasting.cta}<Arrow /></button><p class="fine mt-4">Demostración: esta consulta no envía una reserva.</p><div id="tasting-status" class="status" role="status" aria-live="polite"></div><div id="tasting-slots" hidden></div></form>
    <AmbientControl />
  </div>
</section>
