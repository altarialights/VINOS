  "mobile": {
    "mode": "stacked native sections",
    "parallaxMaxPx": 12,
    "minReadingPause": "content remains in document flow",
    "noPin": true,
    "productViewportHeight": 44,
    "heroImageMinPx": 280,
    "heroImageMaxPx": 420,
    "bottleRotationDeg": 7,
    "backgroundPosition": "58% 50%",
    "leavesOpacity": 0.6,
    "note": "Do not copy the desktop horizontal path into a phone. Use the SAME images with these layouts."
  },
  "tablet": {
    "mode": "desktop composition only when width>=768 and height>=650; otherwise stacked",
    "productScaleMultiplier": 0.86,
    "headlineScaleMultiplier": 0.9
  },
  "transitions": [
    {
      "from": "inicio",
      "to": "origen",
      "rule": "Bottle exits right; background only shallow scale. Leaf passes edge, never masks navigation."
    },
    {
      "from": "origen",
      "to": "uva",
      "rule": "Same cluster enters left. No new landscape or leaf variants."
    },
    {
      "from": "uva",
      "to": "nariz",
      "rule": "Cluster exits left while glass fades in; quiet crossfade, no fruit-to-glass morph."
    },
    {
      "from": "nariz",
      "to": "boca",
      "rule": "Same glass moves across. Keep glass vertical: rotating a flat filled glass produces an implausible liquid surface."
    },
    {
      "from": "boca",
      "to": "comprar",
      "rule": "Finish sticky track; commerce follows in normal document flow, same vineyard plate and bottle."
    },
    {
      "from": "comprar",
      "to": "cata",
      "rule": "Natural section boundary through dark olive; fixed tasting plate, no claimed continuous camera travel into new geometry."
    }
  ]
}
